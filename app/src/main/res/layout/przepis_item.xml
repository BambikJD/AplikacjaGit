<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginTop="8dp"
    android:background="@color/grey_850"
    android:orientation="vertical"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/nazwa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Nazwa Przepisu"
            android:textColor="@color/green_400"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/kalorycznosc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="500 kcal"
            android:textColor="@color/white"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/opis"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="Krótki opis wykonania..."
        android:textColor="@color/white_50"
        android:textSize="14sp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginVertical="8dp"
        android:background="@color/grey_600" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/produktyPotrzebne"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            tools:itemCount="3"
            tools:listitem="@layout/produkt_potrzebny_item" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:gravity="end"
            android:orientation="vertical">

            <TextView android:id="@+id/bialka" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="B: 30" android:textColor="@color/white_50" android:textSize="12sp" />
            <TextView android:id="@+id/tluszcze" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="T: 15" android:textColor="@color/white_50" android:textSize="12sp" />
            <TextView android:id="@+id/weglowodany" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="W: 60" android:textColor="@color/white_50" android:textSize="12sp" />

            <TextView
                android:id="@+id/iloscGram"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="400g"
                android:textColor="@color/green_400"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>