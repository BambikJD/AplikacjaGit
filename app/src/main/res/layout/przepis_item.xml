<?xml version="1.0" encoding="utf-8"?>
    <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        xmlns:app="http://schemas.android.com/apk/res-auto"
    android:alpha="0.8"
        android:background="@color/green_500"
        android:layout_height="wrap_content"
        android:layout_marginVertical="1dp"
        app:cardBackgroundColor="@color/grey_600">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginLeft="10dp"
            android:layout_marginRight="10dp"
            android:layout_height="248dp"
            android:padding="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="190dp"
                android:layout_marginBottom="10dp"
                android:orientation="horizontal"
                android:layout_alignParentBottom="true">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="2"
                    android:background="@color/grey_500"
                    android:id="@+id/opis">
                </TextView>

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="0dp"
                    android:id="@+id/produktyPotrzebne"
                    android:layout_height="match_parent"
                    android:background="@color/grey_550"
                    android:layout_weight="1">
                </androidx.recyclerview.widget.RecyclerView>

            </LinearLayout>

            <TextView
                android:id="@+id/nazwa"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_alignParentStart="true"
                android:layout_marginLeft="6dp"
                android:gravity="center_vertical"
                android:maxWidth="130dp"
                android:text="Nazwa"
                android:textSize="13sp" />

            <LinearLayout
                android:id="@+id/kalorycznoscInfo"
                android:layout_width="120dp"
                android:layout_height="48dp"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:gravity="center_vertical"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/kalorycznosc"
                    android:layout_width="match_parent"
                    android:layout_height="20dp"
                    android:layout_alignParentEnd="false"
                    android:layout_centerVertical="true"
                    android:gravity="center"
                    android:text="kalorycznosc"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal">


                    <TextView
                        android:id="@+id/bialka"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="B"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/weglowodany"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="W"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tluszcze"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:text="T"
                        android:textSize="13sp" />
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/iloscGram"
                android:layout_width="50dp"
                android:layout_height="48dp"
                android:layout_marginEnd="30dp"
                android:layout_toStartOf="@+id/kalorycznoscInfo"
                android:gravity="center_vertical|end"
                android:ems="10"
     />

            <TextView
                android:id="@+id/g"
                android:layout_width="20dp"
                android:layout_height="48dp"
                android:layout_marginRight="10dp"
                android:gravity="center_vertical"
                android:layout_toStartOf="@+id/kalorycznoscInfo"
                android:text="g" />
        </RelativeLayout>
    </androidx.cardview.widget.CardView>
