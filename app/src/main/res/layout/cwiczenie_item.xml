<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="8dp"
    android:layout_marginBottom="2dp"
    android:background="@color/black_26">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="4"
        android:orientation="vertical">

        <TextView
            android:id="@+id/nazwaCwiczenia"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Wyciskanie hantli"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/partiaMiesniowa"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Klatka piersiowa"
            android:textColor="@color/green_400"
            android:textSize="14sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/dodajDoTreningu"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:src="@drawable/ikonadodaj" />

</LinearLayout>