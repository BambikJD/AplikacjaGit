<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="2dp"
    app:cardBackgroundColor="@color/grey_850"
    app:cardCornerRadius="4dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">

        <TextView
            android:id="@+id/nazwa"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Jajecznica"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@+id/iloscGram"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/kalorycznosc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="350 kcal"
            android:textColor="@color/green_400"
            android:textSize="12sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/nazwa" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintStart_toEndOf="@id/kalorycznosc"
            app:layout_constraintTop_toBottomOf="@id/nazwa"
            android:layout_marginStart="10dp">

            <TextView android:id="@+id/bialka" android:text="B:20" android:textColor="@color/white_50" android:textSize="12sp" android:layout_marginEnd="5dp" android:layout_height="20dp" android:layout_width="wrap_content"/>
            <TextView android:id="@+id/tluszcze" android:text="T:10" android:textColor="@color/white_50" android:textSize="12sp" android:layout_marginEnd="5dp" android:layout_height="20dp" android:layout_width="wrap_content"/>
            <TextView android:id="@+id/weglowodany" android:text="W:5" android:textColor="@color/white_50" android:textSize="12sp" android:layout_height="20dp" android:layout_width="wrap_content"/>
        </LinearLayout>

        <TextView
            android:id="@+id/iloscGram"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="16dp"
            android:text="150g"
            android:textColor="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/UsunButton"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageButton
            android:id="@+id/UsunButton"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ikonausun"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@color/red_400" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.cardview.widget.CardView>